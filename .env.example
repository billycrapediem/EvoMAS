# Shared defaults for the full pipeline AND the one-instance smoke test.
# Meta-model, judge, and all agent models use MODEL_ID unless overridden below.
# Use openai: for an OpenAI-compatible endpoint (including DeepSeek).
MODEL_ID=
BASE_URL=
API_KEY=

# Optional full-pipeline role overrides. Leave commented to share MODEL_ID.
# META_MODEL=openai:another-model
# Set the judge value to none to use dataset evaluation instead of an LLM judge.
# JUDGE_MODEL=openai:another-model
# AGENT_MODELS="openai:model-one openai:model-two"

# Exported environment variables override .env values; CLI model flags override
# role defaults. OpenAI-compatible roles share BASE_URL and API_KEY.
# Native Bedrock/Anthropic/Google overrides use their provider credentials.
